      \"url\": \"https://iris", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": ".who.int/server/api/core/bitstreams/c64e3f48-6", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "aea-4c7d-9c02-1e0a9ee4dccc/content\",\n      ", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "\"source_label\": \"World Health Organization, 2009\",\n      \"provenance\": \"grounded\",\n      ", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "\"confidence\": 0.95,\n      \"strength\": 0.0\n    },\n    {\n", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "      \"claim_id\": \"c1\",\n      \"stance\": \"support\",\n      \"quote\": \"", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "The review concludes that the most important effects are increased prevalences of respiratory symptoms, allergies and asthma as well as perturbation of", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": " the immunological system.\",\n      \"url\": \"https://iris.who.int/server/api/core/bit", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "streams/c64e3f48-6aea-4c7d-9c02-", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "1e0a9ee4dccc/content\",\n      \"source_label\": \"World Health Organization,", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": " 2009\",\n      \"provenance\": \"grounded\",\n      \"confidence\": 0.", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "92,\n      \"strength\": 0.0\n    }\n  ],\n  \"confidence\": ", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"delta": {"text": "0.9\n}", "type": "text"}, "index": 3, "event_type": "step.delta"}, {"index": 3, "event_type": "step.stop"}, {"interaction": {"id": "v1_ChdSQlRtYXNtdU5OYXR4TjhQMktUanlRSRIXUkJUbWFzbXVOTmF